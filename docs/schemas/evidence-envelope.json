    "source_uri": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Uri"
    },
    "subject": {
      "$ref": "#/$defs/EvidenceSubject"
    },
    "validation": {
      "$ref": "#/$defs/EvidenceValidation"
    },
    "version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "media_type",
    "digests",
    "producer",
    "collected_at",
    "validation"
  ],
  "title": "EvidenceEnvelope",
  "type": "object"
}
