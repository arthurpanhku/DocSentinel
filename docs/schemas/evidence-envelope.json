        "release": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release"
        },
        "repository": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository"
        }
      },
      "title": "EvidenceSubject",
      "type": "object"
    },
    "EvidenceValidation": {
      "additionalProperties": false,
      "properties": {
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "errors": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "status": {
          "enum": [
            "valid",
            "invalid",
            "unsupported",
            "not_verified"
          ],
          "title": "Status",
          "type": "string"
        },
        "validator": {
          "title": "Validator",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "validator",
        "version",
        "status",
        "checked_at"
      ],
      "title": "EvidenceValidation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Provider-neutral envelope. Validation status is never inferred by an LLM.",
  "properties": {
    "collected_at": {
      "format": "date-time",
      "title": "Collected At",
      "type": "string"
    },
    "confidentiality": {
      "default": "internal",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "title": "Confidentiality",
      "type": "string"
    },
    "derived_from": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Derived From",
      "type": "array"
    },
    "digests": {
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1,
      "title": "Digests",
      "type": "object"
    },
    "evidence_id": {
      "format": "uuid",
      "title": "Evidence Id",
      "type": "string"
    },
    "kind": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Kind",
      "type": "string"
    },
    "locators": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceLocator"
      },
      "title": "Locators",
      "type": "array"
    },
    "media_type": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Media Type",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "produced_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Produced At"
    },
    "producer": {
      "$ref": "#/$defs/EvidenceProducer"
    },
    "retention_policy": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retention Policy"
    },
    "schema_uri": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Schema Uri"
    },
    "signature": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceSignature"
        },
        {
          "type": "null"
        }
      ],
      "default": null
